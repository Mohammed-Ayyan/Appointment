datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?
  password      String
  role          String  @default("user")
  phone         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account      Account[]
  session      Session[]
  appointments Appointment[]
  reviews      Review[]

  @@map("users")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refreshToken       String? @map("refresh_token") @db.Text
  accessToken        String? @map("access_token") @db.Text
  expiresAt          Int?    @map("expires_at")
  tokenType          String? @map("token_type")
  scope              String?
  idToken            String? @map("id_token") @db.Text
  sessionState       String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String  @id @default(cuid())
  sessionToken String  @unique @map("session_token")
  userId       String  @map("user_id")
  expires      DateTime
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ServiceProvider {
  id             Int      @id @default(autoincrement())
  userId         String?  @map("user_id")
  name           String
  specialty      String?
  rating         Float    @default(0)
  reviewsCount   Int      @default(0) @map("reviews_count")
  price          String?
  availability   String?
  image          String?
  specialization String?
  experience     String?
  location       String?
  avatar         String?
  phone          String?
  email          String   @unique
  address        String?
  about          String?  @db.Text
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  languages       ProviderLanguage[]
  specializations ProviderSpecialization[]
  reviewsList     Review[]
  timeSlots       TimeSlot[]
  appointments    Appointment[]

  @@index([email])
  @@index([userId])
  @@map("service_providers")
}

model ProviderLanguage {
  id         Int             @id @default(autoincrement())
  language   String
  providerId Int             @map("provider_id")
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_languages")
}

model ProviderSpecialization {
  id             Int             @id @default(autoincrement())
  specialization String
  providerId     Int             @map("provider_id")
  provider       ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_specializations")
}

model Review {
  id         Int             @id @default(autoincrement())
  userId     String?         @map("user_id")
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  rating     Int
  date       String
  comment    String          @db.Text
  avatar     String?
  providerId Int             @map("provider_id")
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([providerId])
  @@index([userId])
  @@map("reviews")
}

model TimeSlot {
  id         Int             @id @default(autoincrement())
  time       String
  day        String?
  providerId Int             @map("provider_id")
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("time_slots")
}

model Appointment {
  id            Int             @id @default(autoincrement())
  userId        String?         @map("user_id")
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  patientName   String          @map("patient_name")
  patientEmail  String?         @map("patient_email")
  patientPhone  String?         @map("patient_phone")
  date          DateTime
  time          String
  service       String
  duration      String?
  status        String          @default("Pending")
  paymentAmount Float           @default(0) @map("payment_amount")
  paymentStatus String          @default("Unpaid") @map("payment_status")
  notes         String?         @db.Text
  providerId    Int             @map("provider_id")
  provider      ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([providerId])
  @@index([userId])
  @@index([date])
  @@map("appointments")
}
